{
  // Cloudflare Workers deployment. `npm run build` writes the static export to
  // ./out, which is served through the assets binding. The _headers file in out/
  // sets content-types + CORS.
  //
  // The Worker script exists for the two agent endpoints: POST /api/proposals
  // (the write path) and POST /mcp (the remote MCP server). aboard is a static
  // export, so Next Route Handlers are GET-only and there is no server runtime —
  // neither can be a Next route. They live in the Worker instead: same origin,
  // same deploy, and the GitHub credential never leaves the server. Every other
  // path falls straight through to the assets binding.
  //
  // /mcp needs no binding of its own. The 2026-07-28 MCP spec is stateless, so
  // there is no session to keep: no KV, no Durable Object, no nodejs_compat. The
  // server card is a static file under public/.well-known/, served by ASSETS.
  "name": "aboard",
  "compatibility_date": "2025-06-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",

    // Assets are served BEFORE the Worker runs by default, so a request for a
    // path that matches a static file never reaches the script. Markdown
    // content negotiation has to see the request to answer it, so the page
    // routes that have Markdown twins run the Worker first; it falls through to
    // this same binding for anything it does not negotiate. Listed per route
    // rather than `true` so the JS chunks, images and JSON-LD assets keep being
    // served straight from the asset layer with no Worker invocation.
    "run_worker_first": ["/", "/about", "/claims/*", "/dossiers/*"]
  },

  // Custom domain for the Worker. On deploy, Cloudflare provisions the DNS
  // record and cert automatically — provided the untype.me zone is in this
  // account (its nameservers are Cloudflare's). After this lands and resolves,
  // remove the SITE_URL build variable in the dashboard so siteBaseUrl() falls
  // back to its canonical default (https://aboard.untype.me) and the JSON-LD
  // @ids carry the real domain instead of the workers.dev origin.
  "routes": [
    { "pattern": "aboard.untype.me", "custom_domain": true }
  ],

  "vars": {
    "GITHUB_REPO": "ostin-pil/aboard",
    "GITHUB_BASE_BRANCH": "main"
  },

  // Flood brake on POST /api/proposals, keyed per agent credential (proposal:<tokenId>).
  // Native Workers rate limiting: no namespace to provision — namespace_id is an
  // arbitrary account-local number, and `wrangler deploy` is all it takes. period
  // is restricted to 10 or 60 seconds, so this caps a burst (a leaked or runaway
  // token opening PRs), not a long-window quota; the limit mirrors RATE_LIMIT_PERIOD_S
  // in worker/index.ts. A per-hour/day quota would need KV or a Durable Object.
  "ratelimits": [
    {
      "name": "PROPOSAL_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]

  // Secrets — set with `wrangler secret put`, never committed:
  //   ABOARD_AGENT_TOKENS  JSON map: token -> { tokenId, operator, agent, agentId }
  //   GITHUB_TOKEN         fine-grained PAT, contents + pull-requests, this repo only
  //
  // With neither set, /api/proposals answers 503 not_configured and the rest of
  // the site is unaffected.
}
