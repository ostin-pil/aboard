# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local worktrees (linked git worktrees, not committed)
.claude/worktrees/

# wrangler local dev state (created by `wrangler dev`, never committed)
.wrangler/

# MCP registry scratch (`mcp-publisher init` writes here). The server card at
# public/.well-known/mcp.json is the only source, and `mcp-publisher publish`
# takes a path, so a root copy is drift with nothing to gain.
/server.json
