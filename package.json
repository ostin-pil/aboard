{
  "name": "aboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "check:built-urls": "node scripts/check-built-urls.mjs",
    "lint:resolution": "npx tsx scripts/lint-resolution.ts",
